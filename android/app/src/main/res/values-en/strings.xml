    <string name="privacy">Permissions and privacy</string>
    <string name="privacy_hint">Who receives your data, what stays on the phone, and who is allowed to do what. With buttons to take it back, not just to read about it.</string>
    <string name="privacy_where">Where your data goes</string>
    <string name="privacy_nowhere">No service configured: nothing leaves the phone yet.</string>
    <string name="privacy_what_travels">What you send travels: message text, attachment descriptions or images, text extracted from documents, and tool results. Never another service\'s keys.</string>
    <string name="privacy_stays">What stays on the phone</string>
    <string name="privacy_stays_detail">%1$d conversations in the local database and %2$s MB of attachments in the app\'s private folder. API keys are encrypted with the Keystore and excluded from backups.</string>
