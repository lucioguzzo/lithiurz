    <string name="free_start">No key configured. You can start for free.</string>
    <string name="onboarding_welcome">GUZZOBOT has no servers of its own: it talks straight to the model you choose, and conversations stay on your phone. That is why it needs a model — and you can start for free, in a couple of minutes.</string>
    <string name="onboarding_start">Let\'s start</string>
    <string name="onboarding_key_title">Start free with Gemini</string>
    <string name="onboarding_key_why">Google\'s Gemini is the best free tier: no credit card, and among the free ones it is the only one that can also read images. It needs a key, and no app can get it for you: Google does not allow it, and giving the app access to your account would achieve nothing. But we do the hard part.</string>
    <string name="onboarding_open_studio">Open the key page</string>
    <string name="onboarding_step_1">On your phone you are already signed in with your Google account: no need to sign in again.</string>
    <string name="onboarding_step_2">Tap "Create API key" and accept Google\'s terms.</string>
    <string name="onboarding_step_3">Copy the key and come back: I will spot it by myself.</string>
    <string name="onboarding_found">I found a key in your clipboard: %1$s</string>
    <string name="onboarding_use_found">Use this key</string>
    <string name="onboarding_paste_here">Or paste the key here</string>
    <string name="onboarding_verify">Check and save</string>
    <string name="onboarding_checking">Trying the key with the provider…</string>
    <string name="onboarding_key_ok">It works: %1$d models available.</string>
    <string name="onboarding_key_bad">The key was not accepted.</string>
    <string name="onboarding_continue">Next</string>
    <string name="onboarding_later">I\'ll do it later</string>
    <string name="onboarding_other_free">Other free providers</string>
    <string name="onboarding_permissions_title">Two permissions, that\'s all</string>
    <string name="onboarding_permissions_why">Android asks for these, not us, and they do only what it says here. You can say no now and change your mind later.</string>
    <string name="onboarding_notifications_why">To tell you when a long job finishes, even if you closed the app in the meantime.</string>
    <string name="onboarding_mic_why">To dictate instead of typing. Audio is recorded only while you hold the button.</string>
    <string name="onboarding_permissions_note">Documents and photos need no permission at all: you pick the file each time, and the app sees only that one.</string>
    <string name="onboarding_allow">Allow</string>
    <string name="onboarding_done">Done</string>
