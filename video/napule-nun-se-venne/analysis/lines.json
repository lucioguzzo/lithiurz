 {
  "text": "Da Carosone a Pino, pe' 'e strade d''o Sud",
  "sec": 6,
  "start": 184.48,
  "end": 187.36
 },
 {
  "text": "Ogni nota tene ancora 'o stesso blues",
  "sec": 6,
  "start": 189.36,
  "end": 193.44
 },
 {
  "text": "Nun serve essere antico pe' essere reale",
  "sec": 6,
  "start": 194.36,
  "end": 198.36
 },
 {
  "text": "Basta cantà cu 'o core, senza mascherà",
  "sec": 6,
  "start": 199.94,
  "end": 203.36
 },
 {
  "text": "Napule è musica quanno racconta",
  "sec": 7,
  "start": 205.82,
  "end": 208.36
 },
 {
  "text": "'A fatica, l'ammore e pure 'a lotta",
  "sec": 7,
  "start": 209.96,
  "end": 213.82
 },
 {
  "text": "E mentre 'o viento se porta 'e stagioni",
  "sec": 7,
  "start": 215.0,
  "end": 220.64
 },
 {
  "text": "Restano 'e vere canzoni",
  "sec": 7,
  "start": 221.44,
  "end": 226.46
 },
 {
  "text": "Napule nun se venne",
  "sec": 8,
  "start": 227.44,
  "end": 229.42
 },
 {
  "text": "Napule nun se piega",
  "sec": 8,
  "start": 232.24,
  "end": 234.42
 },
 {
  "text": "Napule canta ancora...",
