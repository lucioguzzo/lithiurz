[
 {
  "text": "Napule è 'na chitarra cu 'e corde consumate",
  "sec": 0,
  "start": 20.78,
  "end": 26.42
 },
 {
  "text": "'Na voce rauca dint' 'e notti affaticate",
  "sec": 0,
  "start": 26.42,
  "end": 31.76
 },
 {
  "text": "È 'o blues d''e vicoli, 'o mare e 'a poesia",
  "sec": 0,
  "start": 31.76,
  "end": 36.42
 },
 {
  "text": "Nun è na moda ca se cambia ogne via",
  "sec": 0,
  "start": 37.36,
  "end": 40.76
 },
 {
  "text": "Napule è 'na mano sopra a nu pianoforte",
  "sec": 1,
  "start": 42.56,
  "end": 47.66
 },
 {
  "text": "È 'na parola sincera cchiù forte",
  "sec": 1,
  "start": 47.66,
  "end": 53.6
 },
 {
  "text": "D''e luci finte e d''e numeri pe' fa'",
  "sec": 1,
  "start": 54.44,
  "end": 59.82
 },
 {
  "text": "Credere a tutti ca chesta è libertà",
  "sec": 1,
  "start": 59.82,
  "end": 64.6
 },
 {
  "text": "Napule nun se venne",
  "sec": 2,
  "start": 65.36,
  "end": 69.1
 },
 {
  "text": "Pe' quatto click e na fotografia",
  "sec": 2,
  "start": 69.1,
  "end": 73.14
 },
 {
  "text": "Napule nun se venne",
  "sec": 2,
  "start": 75.04,
  "end": 79.02
 },
 {
  "text": "Pe' nu ritornello senza fantasia",
  "sec": 2,
  "start": 79.42,
  "end": 83.28
 },
 {
  "text": "E quanno 'a musica nasce d''o core",
  "sec": 2,
  "start": 83.28,
  "end": 89.3
 },
 {
  "text": "Nun tene bisogno 'e pubblicità",
  "sec": 2,
  "start": 89.3,
  "end": 93.62
 },
 {
  "text": "Napule nun se venne",
  "sec": 2,
  "start": 93.62,
  "end": 100.44
 },
 {
  "text": "È verità",
  "sec": 2,
  "start": 100.44,
  "end": 103.7
 },
 {
  "text": "Mo sento troppi voci tutte uguale",
  "sec": 3,
  "start": 104.56,
  "end": 108.44
 },
 {
  "text": "Autotune e rumore industriale",
  "sec": 3,
  "start": 109.7,
  "end": 113.44
 },
 {
  "text": "Parole senza tiempo e senza storia",
  "sec": 3,
  "start": 114.06,
  "end": 118.88
 },
 {
  "text": "Ca passano veloci e perdono memoria",
  "sec": 3,
  "start": 119.27,
  "end": 123.58
 },
 {
  "text": "Ma ccà ce stanno ancora 'e canzoni vere",
  "sec": 4,
  "start": 124.07,
  "end": 128.16
 },
 {
  "text": "Chille ca fanno chiagnere 'e piacere",
  "sec": 4,
  "start": 128.16,
  "end": 133.08
 },
 {
  "text": "Chille ca sanno 'e sale, viento e libertà",
  "sec": 4,
  "start": 133.08,
  "end": 139.16
 },
 {
  "text": "E parlano cu ll'anema d''a città",
  "sec": 4,
  "start": 139.92,
  "end": 144.16
 },
 {
