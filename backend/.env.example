# Copiare in .env e adattare. Nessuna di queste chiavi finisce nell'app.

# --- Fornitore IA: anthropic | openai | echo ---------------------------
# "echo" non usa la rete: utile per sviluppo e test.
VOCENOTA_PROVIDER=echo

VOCENOTA_ANTHROPIC_API_KEY=
VOCENOTA_ANTHROPIC_MODEL=claude-haiku-5-5

VOCENOTA_OPENAI_API_KEY=
VOCENOTA_OPENAI_MODEL=gpt-4o-mini
# Per un gateway compatibile OpenAI:
# VOCENOTA_OPENAI_BASE_URL=https://api.esempio.it/v1

# --- Controllo dei costi ----------------------------------------------
# Prezzi del listino del fornitore scelto, per milione di token.
VOCENOTA_PRICE_INPUT_PER_MTOK=1.0
VOCENOTA_PRICE_OUTPUT_PER_MTOK=5.0
# Superato il tetto, il cloud si spegne da solo fino al giorno dopo (UTC).
VOCENOTA_DAILY_BUDGET_USD=5.0

# --- Quote per dispositivo --------------------------------------------
VOCENOTA_DAILY_REQUESTS_PER_DEVICE=20
VOCENOTA_DAILY_CHARS_PER_DEVICE=400000
VOCENOTA_RATE_LIMIT_REQUESTS=6
VOCENOTA_RATE_LIMIT_WINDOW_SECONDS=60
VOCENOTA_MAX_INPUT_CHARS=220000

# --- Sintesi gerarchica -----------------------------------------------
VOCENOTA_MAP_REDUCE_THRESHOLD_CHARS=12000
VOCENOTA_CHUNK_CHARS=9000
VOCENOTA_CHUNK_OVERLAP_CHARS=400

# --- Accesso -----------------------------------------------------------
# Token pubblico dell'app: NON è un segreto, screma solo il traffico.
# Deve coincidere con --dart-define=VOCENOTA_APP_TOKEN usato nella build.
VOCENOTA_APP_TOKEN=
# Chiave degli endpoint /admin/*. Vuota = amministrazione disattivata.
VOCENOTA_ADMIN_TOKEN=

# --- Persistenza -------------------------------------------------------
VOCENOTA_DATABASE_PATH=/dati/usage.db

# Interruttore manuale globale.
VOCENOTA_DISABLED=false
