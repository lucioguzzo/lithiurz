# Copiare in .env e adattare. Nessuna di queste chiavi finisce nell'app.

# --- Fornitore IA: anthropic | openai | echo ---------------------------
# "echo" non usa la rete: utile per sviluppo e test.
BRIEF_PROVIDER=echo

BRIEF_ANTHROPIC_API_KEY=
BRIEF_ANTHROPIC_MODEL=claude-haiku-5-5

BRIEF_OPENAI_API_KEY=
BRIEF_OPENAI_MODEL=gpt-4o-mini
# Per un gateway compatibile OpenAI:
# BRIEF_OPENAI_BASE_URL=https://api.esempio.it/v1

# --- Trascrizione nel cloud: gemini | echo -----------------------------
# "echo" non usa la rete. Con "gemini" l'audio dei blocchi viene inoltrato
# all'API di Google.
#
# ATTENZIONE, non è un dettaglio: i termini dell'API Gemini impongono che
# un'app rivolta a utenti nello Spazio economico europeo, in Svizzera o nel
# Regno Unito usi SOLTANTO servizi a pagamento. Usa quindi la chiave di un
# progetto con fatturazione attiva. Sul piano a pagamento Google dichiara
# anche di non usare i contenuti per migliorare i propri prodotti.
BRIEF_TRANSCRIPTION_PROVIDER=echo
BRIEF_GEMINI_API_KEY=
BRIEF_GEMINI_MODEL=gemini-3.8-flash
# BRIEF_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
BRIEF_TRANSCRIPTION_TIMEOUT_SECONDS=180

# Dimensione massima del blocco audio (Gemini ammette 20 MB per richiesta
# comprensivi della codifica base64, che gonfia di un terzo).
BRIEF_MAX_AUDIO_BYTES=12582912
# Audio trascrivibile da un dispositivo in un giorno, in secondi.
BRIEF_DAILY_AUDIO_SECONDS_PER_DEVICE=3600
# Gemini conta l'audio 32 token al secondo.
BRIEF_AUDIO_TOKENS_PER_SECOND=32
# Prezzo dei token audio in ingresso, per milione (listino del modello).
BRIEF_PRICE_AUDIO_INPUT_PER_MTOK=0.75

# --- Controllo dei costi ----------------------------------------------
# Prezzi del listino del fornitore scelto, per milione di token.
BRIEF_PRICE_INPUT_PER_MTOK=1.0
BRIEF_PRICE_OUTPUT_PER_MTOK=5.0
# Superato il tetto, il cloud si spegne da solo fino al giorno dopo (UTC).
BRIEF_DAILY_BUDGET_USD=5.0

# --- Quote per dispositivo --------------------------------------------
BRIEF_DAILY_REQUESTS_PER_DEVICE=20
BRIEF_DAILY_CHARS_PER_DEVICE=400000
BRIEF_RATE_LIMIT_REQUESTS=6
BRIEF_RATE_LIMIT_WINDOW_SECONDS=60
BRIEF_MAX_INPUT_CHARS=220000

# --- Sintesi gerarchica -----------------------------------------------
BRIEF_MAP_REDUCE_THRESHOLD_CHARS=12000
BRIEF_CHUNK_CHARS=9000
BRIEF_CHUNK_OVERLAP_CHARS=400

# --- Accesso -----------------------------------------------------------
# Token pubblico dell'app: NON è un segreto, screma solo il traffico.
# Deve coincidere con --dart-define=BRIEF_APP_TOKEN usato nella build.
BRIEF_APP_TOKEN=
# Chiave degli endpoint /admin/*. Vuota = amministrazione disattivata.
BRIEF_ADMIN_TOKEN=

# --- Persistenza -------------------------------------------------------
BRIEF_DATABASE_PATH=/dati/usage.db

# Interruttore manuale globale.
BRIEF_DISABLED=false
