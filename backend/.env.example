# Copiare in .env e adattare. Nessuna di queste chiavi finisce nell'app.

# --- Fornitore IA: anthropic | openai | echo ---------------------------
# "echo" non usa la rete: utile per sviluppo e test.
BRIEF_PROVIDER=echo

BRIEF_ANTHROPIC_API_KEY=
BRIEF_ANTHROPIC_MODEL=claude-haiku-5-5

BRIEF_OPENAI_API_KEY=
BRIEF_OPENAI_MODEL=gpt-4o-mini
# Per un gateway compatibile OpenAI:
# BRIEF_OPENAI_BASE_URL=https://api.esempio.it/v1

# --- Controllo dei costi ----------------------------------------------
# Prezzi del listino del fornitore scelto, per milione di token.
BRIEF_PRICE_INPUT_PER_MTOK=1.0
BRIEF_PRICE_OUTPUT_PER_MTOK=5.0
# Superato il tetto, il cloud si spegne da solo fino al giorno dopo (UTC).
BRIEF_DAILY_BUDGET_USD=5.0

# --- Quote per dispositivo --------------------------------------------
BRIEF_DAILY_REQUESTS_PER_DEVICE=20
BRIEF_DAILY_CHARS_PER_DEVICE=400000
BRIEF_RATE_LIMIT_REQUESTS=6
BRIEF_RATE_LIMIT_WINDOW_SECONDS=60
BRIEF_MAX_INPUT_CHARS=220000

# --- Sintesi gerarchica -----------------------------------------------
BRIEF_MAP_REDUCE_THRESHOLD_CHARS=12000
BRIEF_CHUNK_CHARS=9000
BRIEF_CHUNK_OVERLAP_CHARS=400

# --- Accesso -----------------------------------------------------------
# Token pubblico dell'app: NON è un segreto, screma solo il traffico.
# Deve coincidere con --dart-define=BRIEF_APP_TOKEN usato nella build.
BRIEF_APP_TOKEN=
# Chiave degli endpoint /admin/*. Vuota = amministrazione disattivata.
BRIEF_ADMIN_TOKEN=

# --- Persistenza -------------------------------------------------------
BRIEF_DATABASE_PATH=/dati/usage.db

# Interruttore manuale globale.
BRIEF_DISABLED=false
